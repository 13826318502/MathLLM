# Copy this file to .env.local, or run configure.bat to edit it in a dialog.
#
# Orchestrator (cloud): task routing, planning and answer verification.
# Leave MATHLLM_ORCHESTRATOR_API_KEY empty to disable it and stay fully local.
MATHLLM_ORCHESTRATOR_BASE_URL=https://api.deepseek.com/v1
MATHLLM_ORCHESTRATOR_MODEL=deepseek-chat
MATHLLM_ORCHESTRATOR_API_KEY=
# When the cloud endpoint is unreachable: local (fall back) or fail.
MATHLLM_ORCHESTRATOR_FALLBACK=local
# Reasoning models spend output budget on thinking before writing anything, so
# the orchestrator gets more headroom than the local solver.
MATHLLM_ORCHESTRATOR_MAX_OUTPUT_TOKENS=2048

# Solver (local): the fine-tuned model that does the actual math solving.
MATHLLM_SOLVER_BASE_URL=http://127.0.0.1:11434/v1
MATHLLM_SOLVER_MODEL=mathllm-round7
MATHLLM_SOLVER_API_KEY=ollama

# Solver answer budget. Step-by-step solutions with display math easily exceed
# 512 tokens and get cut off mid-formula, so the default is larger.
MATHLLM_MAX_OUTPUT_TOKENS=1024
MATHLLM_MEMORY_TRIGGER_TOKENS=1200
MATHLLM_MEMORY_SUMMARY_MAX_TOKENS=256
MATHLLM_RECENT_HISTORY_MESSAGES=6
MATHLLM_MAX_CONTEXT_TOKENS=2048

# Local application ports
MATHLLM_API_HOST=127.0.0.1
MATHLLM_API_PORT=8080
MATHLLM_ALLOW_ORIGINS=http://127.0.0.1:7860,http://localhost:7860

# Knowledge base and RAG. Build the index once with:
#   python -m app.services.rag_service
MATHLLM_KNOWLEDGE_DIR=knowledge
MATHLLM_RAG_PERSIST_DIR=data/chroma
MATHLLM_RAG_COLLECTION=math_knowledge
MATHLLM_RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
MATHLLM_RAG_TOP_K=3
# Embedding model cache. Kept inside the project on purpose: the fastembed
# default lives under the OS temp dir, where a routine temp cleanup can delete
# it and leave a half-populated cache that fails with NO_SUCHFILE.
MATHLLM_FASTEMBED_CACHE_DIR=data/fastembed_cache
# The first index build downloads the embedding model. If HuggingFace is slow,
# uncomment the next line to use a mirror:
# HF_ENDPOINT=https://hf-mirror.com

# Run traces: one JSON line per agent run, for debugging and metrics.
# Stored locally and gitignored. Set MATHLLM_TRACE_ENABLED=0 to turn off.
MATHLLM_TRACE_DIR=data/traces
MATHLLM_TRACE_ENABLED=1

# Independent verification. Math answers are always checked with SymPy.
# Knowledge-base answers are grounded on retrieved chunks and skip the extra
# model calls by default; set to 1 to keep the grounding check.
MATHLLM_VERIFY_RAG=0
