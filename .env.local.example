# Copy this file to .env.local.
# For the downloaded local Ollama model, use:
MATHLLM_API_BASE_URL=http://127.0.0.1:11434/v1
MATHLLM_MODEL_NAME=mathllm-base-cpu
MATHLLM_API_KEY=ollama
# For another OpenAI-compatible provider, replace the three values above.
MATHLLM_MAX_OUTPUT_TOKENS=512
MATHLLM_MEMORY_TRIGGER_TOKENS=1200
MATHLLM_MEMORY_SUMMARY_MAX_TOKENS=256
MATHLLM_RECENT_HISTORY_MESSAGES=6
MATHLLM_MAX_CONTEXT_TOKENS=2048

# Local application ports
MATHLLM_API_HOST=127.0.0.1
MATHLLM_API_PORT=8080
MATHLLM_ALLOW_ORIGINS=http://127.0.0.1:7860,http://localhost:7860
